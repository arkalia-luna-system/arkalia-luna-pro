# 🌕 Arkalia-LUNA — Variables d'environnement Docker
# Configuration pour le démarrage robuste des conteneurs

# Ports des services
PORT_API=8000
PORT_ASSISTANTIA=8001
PORT_REFLEXIA=8002
PORT_COGNITIVE=8003

# Environnement
ARKALIA_ENV=development
ASSISTANTIA_ENV=production
REFLEXIA_ENV=production
SANDOZIA_ENV=development
COGNITIVE_REACTOR_ENV=production

# Niveaux de log
ARKALIA_LOG_LEVEL=INFO
ASSISTANTIA_LOG_LEVEL=INFO
SANDOZIA_LOG_LEVEL=INFO

# Configuration Ollama (pour AssistantIA)
OLLAMA_HOST=host.docker.internal
OLLAMA_PORT=11434

# Configuration Sandozia
SANDOZIA_MONITORING_ENABLED=true
SANDOZIA_ENHANCED_MODE=true

# Timeouts et retries
HEALTHCHECK_TIMEOUT=20
HEALTHCHECK_RETRIES=3
HEALTHCHECK_START_PERIOD=180

# Ressources Docker
DOCKER_MEMORY_LIMIT=512M
DOCKER_CPU_LIMIT=1.0
