[run]
source =
    modules
    core
    helloria
    app
    arkalia
branch = True
parallel = True
concurrency = multiprocessing
omit =
    */__pycache__/*
    */migrations/*
    setup.py
    */generated/*
    */temp/*
    */cache/*
    */tests/*
    */venv/*
    */.venv/*
    */env/*
    */.env/*
    */node_modules/*
    */dist/*
    */build/*
    */htmlcov/*
    */.pytest_cache/*
    */.mypy_cache/*
    */generative_ai/generated/*
    */security/sandbox/*
    */security/watchdog/*
    */helloria/main.py
    */helloria/state.py
    */utils_enhanced/core.py
    # Exclure les modules qui n'ont pas de tests
    */core/adapters/*
    */core/config/*
    */core/factories/*
    */core/health/*
    */core/interfaces/*
    */core/optimizations/*
    */core/orchestrator/*
    */core/storage/*
    */core/utils/*
    */sandozia/analyzer/*
    */sandozia/core/chronalia.py
    */sandozia/core/cognitive_reactor.py
    */sandozia/core/sandozia_core.py
    */sandozia/reasoning/*
    */sandozia/utils/*
    */sandozia/validators/*
    */security/crypto/*
    */taskia/*
    */utils/error_recovery/*
    */utils/helpers/*
    */utils/validators/*
    */utils_enhanced/*
    */zeroia/circuit_breaker.py
    */zeroia/confidence_score.py
    */zeroia/coordinator.py
    */zeroia/decision_engine.py
    */zeroia/error_recovery_system.py
    */zeroia/event_store.py
    */zeroia/graceful_degradation.py
    */zeroia/metrics.py
    */zeroia/orchestrator_enhanced.py
    */zeroia/reason_loop_enhanced.py
    */zeroia/state_manager.py
    */cognitive_reactor/core.py
    */cognitive_reactor/metrics.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if 0:
    if __name__ == .__main__.:
    class .*\bProtocol\):
    @(abc\.)?abstractmethod
    if TYPE_CHECKING:
    @overload
show_missing = True
skip_covered = False
fail_under = 5
